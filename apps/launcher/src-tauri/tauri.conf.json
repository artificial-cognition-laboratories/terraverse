{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terraverse",
  "version": "0.1.1",
  "identifier": "net.arclabs.terraverse.launcher",
  "build": {
    "beforeDevCommand": "bun run ui",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "bun run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Terraverse",
        "width": 960,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5OTcyMTk3NkYxQjI1RDUKUldUVkpSdHZseUdYcVZkUUVqSjBGQm0xUDdTMWp2K0pBcHZNWVhDZjZaaGc5eHVIeDJkTTJKcDYK",
      "endpoints": [
        "https://github.com/artificial-cognition-laboratories/terraverse/releases/download/launcher/latest.json"
      ]
    }
  }
}
