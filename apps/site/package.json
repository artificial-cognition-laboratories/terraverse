{
  "name": "terraverse-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "bunx serve .output/public",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "check": "nuxt typecheck && bash ../../scripts/release/install-check.sh && nuxt generate",
    "deploy": "bun run deploy.ts",
    "verify": "bun run verify.ts",
    "bake": "bash bake/bake.sh"
  },
  "dependencies": {
    "@iconify-json/simple-icons": "^1.2.86",
    "@iconify-json/vscode-icons": "^1.2.97",
    "@nuxt/content": "^3.12.0",
    "@nuxt/icon": "^2.1.0",
    "nuxt": "^4.2.1",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "sass-embedded": "^1.87.0",
    "vue-tsc": "^3.1.0",
    "typescript": "^5.9.0"
  }
}
