{
    "name": "terraverse-site",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "nuxt dev",
        "dev:local": "nuxt dev --port 3517 --dotenv .env.local",
        "build": "nuxt generate",
        "preview": "bunx serve .output/public",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "lint": "oxlint --deny-warnings app scripts nuxt.config.ts content.config.ts",
        "check": "nuxt typecheck && bash ../../apps/game/scripts/release/install-check.sh && nuxt generate",
        "deploy": "bun run scripts/deploy.ts",
        "verify": "bun run scripts/verify.ts",
        "bake": "bash scripts/bake.sh"
    },
    "dependencies": {
        "@iconify-json/simple-icons": "^1.2.86",
        "@iconify-json/vscode-icons": "^1.2.97",
        "@nuxt/content": "^3.12.0",
        "@nuxt/icon": "^2.1.0",
        "@supabase/supabase-js": "^2.119.2",
        "nuxt": "^4.2.1",
        "shiki": "^4.6.0",
        "vue": "^3.5.25"
    },
    "devDependencies": {
        "oxlint": "1.94.0",
        "sass-embedded": "^1.87.0",
        "typescript": "^5.9.0",
        "vue-tsc": "^3.1.0"
    }
}
